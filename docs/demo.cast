[0.5257, "o", "\u001b[1m\u001b[36m================================================================================\u001b[0m\n\u001b[1m\u001b[36m      RAFT DISTRIBUTED CONSENSUS ENGINE \u2014 MONTH 1 LIVE DEMONSTRATION           \u001b[0m\n\u001b[1m\u001b[37m            Leader Election, Heartbeat Suppression & Leader Crash Failover    \u001b[0m\n\u001b[1m\u001b[36m================================================================================\u001b[0m\n\n\n\u001b[1m\u001b[33m\u25b6 Step 1: Initializing 3-Node Raft Cluster (In-Memory Fake Network)\u001b[0m\n\u001b[2m\u001b[37m--------------------------------------------------------------------------------\u001b[0m\n[\u001b[36mINIT\u001b[0m] Spawning Nodes 1, 2, 3 with randomized election timeouts [150ms, 300ms]...\n[\u001b[32mINIT\u001b[0m] Cluster online. Nodes started in Follower state awaiting leader heartbeats.\n[Node 3] time=2026-11-15T10:59:13.258+05:30 level=INFO msg=\"started main Raft event loop\" node_id=3 node_id=3\n[Node 1] time=2026-11-15T10:59:13.258+05:30 level=INFO msg=\"started main Raft event loop\" node_id=1 node_id=1\n[Node 2] time=2026-11-15T10:59:13.258+05:30 level=INFO msg=\"started"]
